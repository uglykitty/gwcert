{
    "version": 8,
    "configurePresets": [
        {
            "name": "linux-debug",
            "displayName": "Clang 20.1.2 x86_64-pc-linux-gnu",
            "description": "Using compilers: C = /usr/bin/clang, CXX = /usr/bin/clang++",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "x64-mingw-release",
            "displayName": "x64 MinGw",
            "description": "Using compilers: C = /usr/bin/x86_64-w64-mingw32-gcc, CXX = /usr/bin/x86_64-w64-mingw32-g++",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_CXX_COMPILER": "/usr/bin/x86_64-w64-mingw32-g++",
                "CMAKE_SYSTEM_NAME": "Windows",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "/data/repos/vcpkg/installed/x64-mingw-dynamic",
                "OPENSSL_ROOT_DIR": "/data/repos/vcpkg/installed/x64-mingw-dynamic",
                "CMAKE_OBJDUMP": "/usr/bin/x86_64-w64-mingw32-objdump"
            }
        },
        {
            "name": "x64-msvc-release",
            "displayName": "x64 MSVC Release",
            "description": "Windows x64 release build with MSVC and Qt/OpenSSL provided via CMAKE_PREFIX_PATH",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}
